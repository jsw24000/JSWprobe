ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=points_visibility -DTORCH_API_INCLUDE_EXTENSION_H -isystem /home/3dsm/miniconda3/envs/lingbot-map/lib/python3.10/site-packages/torch/include -isystem /home/3dsm/miniconda3/envs/lingbot-map/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda/include -isystem /home/3dsm/miniconda3/envs/lingbot-map/include/python3.10 -fPIC -std=c++17
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=points_visibility -DTORCH_API_INCLUDE_EXTENSION_H -isystem /home/3dsm/miniconda3/envs/lingbot-map/lib/python3.10/site-packages/torch/include -isystem /home/3dsm/miniconda3/envs/lingbot-map/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda/include -isystem /home/3dsm/miniconda3/envs/lingbot-map/include/python3.10 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_120,code=compute_120 -gencode=arch=compute_120,code=sm_120 --compiler-options '-fPIC' -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/home/3dsm/miniconda3/envs/lingbot-map/lib/python3.10/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/usr/local/cuda/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build visibility.o: compile /home/3dsm/Desktop/JSWprobe/oxford_spires_minimal/scripts/points_visibility/visibility.cpp
build visibility_kernel.cuda.o: cuda_compile /home/3dsm/Desktop/JSWprobe/oxford_spires_minimal/scripts/points_visibility/visibility_kernel.cu
build frustum_cull.cuda.o: cuda_compile /home/3dsm/Desktop/JSWprobe/oxford_spires_minimal/scripts/points_visibility/frustum_cull.cu





build points_visibility.so: link visibility.o visibility_kernel.cuda.o frustum_cull.cuda.o

default points_visibility.so
